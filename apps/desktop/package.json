{
  "name": "remote-pi",
  "version": "0.2.25",
  "private": true,
  "description": "A desktop home for your remote Pi workspaces",
  "author": "Remote Pi",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@remote-pi/core": "0.0.0",
    "@remote-pi/ui": "0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ssh2": "^1.17.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "dev.remotepi.desktop",
    "productName": "Remote Pi",
    "asar": true,
    "icon": "dist/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
